---
source: crates/agentgateway/src/types/local_tests.rs
description: "Config normalization test for consistent_hash: YAML -> LocalConfig -> NormalizedLocalConfig -> YAML"
---
binds:
  - key: bind/3000
    address: "[::]:3000"
    protocol: http
    tunnelProtocol: direct
    mode: standard
    listeners:
      ns/name/bind/3000/listener0:
        gatewayName: name
        gatewayNamespace: ns
        hostname: ""
        key: ns/name/bind/3000/listener0
        listenerName: listener0
        protocol: HTTP
listener_routes:
  - - ns/name/bind/3000/listener0
    - - backends:
          - backend: /ns/name/bind/3000/listener0/default/route0/backend0
            inlinePolicies:
              - loadBalancing:
                  consistentHash:
                    key: "request.headers[\"x-session-id\"]"
            weight: 1
        key: ns/name/bind/3000/listener0/default/route0
        matches:
          - path:
              pathPrefix: /header
        name: route0
        namespace: default
      - backends:
          - backend: /ns/name/bind/3000/listener0/default/route1/backend0
            inlinePolicies:
              - loadBalancing:
                  consistentHash:
                    key: "request.headers.cookie(\"sid\")"
            weight: 1
        key: ns/name/bind/3000/listener0/default/route1
        matches:
          - path:
              pathPrefix: /cookie
        name: route1
        namespace: default
      - backends:
          - backend: /ns/name/bind/3000/listener0/default/route2/backend0
            inlinePolicies:
              - loadBalancing:
                  consistentHash:
                    key: source.address
            weight: 1
        key: ns/name/bind/3000/listener0/default/route2
        matches:
          - path:
              pathPrefix: /source-ip
        name: route2
        namespace: default
      - backends:
          - backend: /ns/name/bind/3000/listener0/default/route3/backend0
            inlinePolicies:
              - loadBalancing:
                  consistentHash:
                    key: "request.headers[\"x-user\"]"
            weight: 1
        key: ns/name/bind/3000/listener0/default/route3
        matches:
          - path:
              pathPrefix: /expression
        name: route3
        namespace: default
listener_tcp_routes:
  - - ns/name/bind/3000/listener0
    - []
policies: []
backends:
  - backend:
      host:
        name: ns/name/bind/3000/listener0/default/route0/backend0
        namespace: ""
        target: "example.com:8080"
  - backend:
      host:
        name: ns/name/bind/3000/listener0/default/route1/backend0
        namespace: ""
        target: "example.com:8080"
  - backend:
      host:
        name: ns/name/bind/3000/listener0/default/route2/backend0
        namespace: ""
        target: "example.com:8080"
  - backend:
      host:
        name: ns/name/bind/3000/listener0/default/route3/backend0
        namespace: ""
        target: "example.com:8080"
route_groups: []
workloads: []
services: []
